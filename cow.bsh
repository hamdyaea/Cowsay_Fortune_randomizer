set -euo pipefail

if [[ ${1:-} == --help ]]; then
  printf '%s\n' 'Usage: cow.bsh [--help]'
  exit 0
fi
if (( $# != 0 )); then
  printf '%s\n' 'Unexpected argument' >&2
  exit 2
fi
for dep in fortune cowsay; do
  command -v "$dep" >/dev/null 2>&1 || { printf 'Missing: %s\n' "$dep" >&2; exit 1; }
done
styles=("" -b -d -g -p -s -t -w -y)
style=${styles[RANDOM % ${#styles[@]}]}
if [[ -n "$style" ]]; then
  fortune | cowsay "$style"
else
  fortune | cowsay
fi
